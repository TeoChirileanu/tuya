#!/bin/sh /etc/rc.common
# Contor Martiniuc — citiri Tuya Cloud la 10s → /opt/tuya/data/cloud_log_martiniuc_*.csv
# Instalat de wrt/install.sh. Jurnal stdout: logread -e tuya-cloud-martiniuc
START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 -u /opt/tuya/src/monitor_cloud.py bf9e529044d17f1bad0v7a martiniuc
    procd_set_param respawn 3600 10 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
